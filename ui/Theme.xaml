<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette: sky blue + soft pink -->
  <SolidColorBrush x:Key="InkBrush" Color="#3E4C6D"/>
  <SolidColorBrush x:Key="InkSoftBrush" Color="#8394AF"/>
  <SolidColorBrush x:Key="SkyBrush" Color="#7FC6EE"/>
  <SolidColorBrush x:Key="SkyDeepBrush" Color="#4DA6DB"/>
  <SolidColorBrush x:Key="SkyPaleBrush" Color="#E9F5FD"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#DFF1FC"/>
  <SolidColorBrush x:Key="PressBrush" Color="#C9E7FA"/>
  <SolidColorBrush x:Key="LineBrush" Color="#DCEBF6"/>
  <SolidColorBrush x:Key="PinkBrush" Color="#E9799C"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#F4F9FE"/>
  <SolidColorBrush x:Key="ReaderBrush" Color="#E4EEF6"/>
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
  <LinearGradientBrush x:Key="ProgressFill" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#8ED0F4" Offset="0"/>
    <GradientStop Color="#FFA9C4" Offset="1"/>
  </LinearGradientBrush>

  <!-- Line icons on a 16x16 grid -->
  <Geometry x:Key="IconPlus">M8,3 L8,13 M3,8 L13,8</Geometry>
  <Geometry x:Key="IconMinus">M3,8 L13,8</Geometry>
  <Geometry x:Key="IconPrev">M10,3.5 L5.5,8 L10,12.5</Geometry>
  <Geometry x:Key="IconNext">M6,3.5 L10.5,8 L6,12.5</Geometry>
  <Geometry x:Key="IconArchive">M2,3 L14,3 L14,6 L2,6 Z M3,6 L3,13 L13,13 L13,6 M6.5,8.5 L9.5,8.5</Geometry>
  <Geometry x:Key="IconRestore">M5.5,3 L2.5,6 L5.5,9 M2.5,6 L10,6 C12.2,6 13.5,7.6 13.5,9.5 C13.5,11.4 12.2,13 10,13 L6,13</Geometry>
  <Geometry x:Key="IconFitWidth">M1.5,8 L14.5,8 M4.5,5 L1.5,8 L4.5,11 M11.5,5 L14.5,8 L11.5,11</Geometry>
  <Geometry x:Key="IconFitPage">M4.5,1.5 L11.5,1.5 L11.5,14.5 L4.5,14.5 Z M6.5,5 L9.5,5 M6.5,8 L9.5,8</Geometry>
  <Geometry x:Key="IconSidebar">M1.5,2.5 L14.5,2.5 L14.5,13.5 L1.5,13.5 Z M5.5,2.5 L5.5,13.5</Geometry>
  <Geometry x:Key="IconEdit">M10.5,2.5 L13.5,5.5 L5.5,13.5 L2.5,13.5 L2.5,10.5 Z M8.5,4.5 L11.5,7.5</Geometry>
  <Geometry x:Key="IconMore">M3,8 L3.01,8 M8,8 L8.01,8 M13,8 L13.01,8</Geometry>
  <Geometry x:Key="IconFullscreen">M1.5,5.5 L1.5,1.5 L5.5,1.5 M10.5,1.5 L14.5,1.5 L14.5,5.5 M14.5,10.5 L14.5,14.5 L10.5,14.5 M5.5,14.5 L1.5,14.5 L1.5,10.5</Geometry>
  <Geometry x:Key="IconNewTab">M2.5,13.5 L2.5,4.5 Q2.5,2.5 4.5,2.5 L11.5,2.5 Q13.5,2.5 13.5,4.5 L13.5,13.5 M1,13.5 L15,13.5 M8,5.5 L8,10.5 M5.5,8 L10.5,8</Geometry>

  <Style x:Key="IconPath" TargetType="{x:Type Path}">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Stretch" Value="None"/>
    <Setter Property="StrokeThickness" Value="1.6"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}"/>
  </Style>

  <!-- Buttons don't take keyboard focus, so arrows and PageDown always go to the book. -->
  <Style x:Key="FlatButton" TargetType="{x:Type ButtonBase}">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ButtonBase}">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource PressBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PillButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Background" Value="{StaticResource SkyBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource SkyDeepBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#3B92C6"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="LinkButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Foreground" Value="{StaticResource SkyDeepBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="8,3"/>
  </Style>

  <Style x:Key="TabButton" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,5">
            <ContentPresenter HorizontalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="White"/>
              <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="Bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="#4E7CA8"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CuteProgress" TargetType="{x:Type ProgressBar}">
    <Setter Property="Height" Value="5"/>
    <Setter Property="Minimum" Value="0"/>
    <Setter Property="Maximum" Value="100"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Grid>
            <Border x:Name="PART_Track" CornerRadius="3" Background="#E3EEF7"/>
            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{StaticResource ProgressFill}" HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PageBoxStyle" TargetType="{x:Type TextBox}">
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="Background" Value="{StaticResource SkyPaleBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="2,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="8">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SkyBrush}"/>
              <Setter TargetName="Bd" Property="Background" Value="White"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Renaming a tab in place: lies over the tab's label without changing the tab's height. -->
  <Style x:Key="TabNameBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource PageBoxStyle}">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="Margin" Value="-7,-3"/>
    <Setter Property="MinWidth" Value="96"/>
    <Setter Property="MaxWidth" Value="230"/>
    <Setter Property="MaxLength" Value="40"/>
  </Style>

  <!-- Soft rounded scrollbars everywhere -->
  <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border x:Name="T" CornerRadius="5" Background="#BBD9EE" Margin="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="T" Property="Background" Value="#94C6E8"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="T" Property="Background" Value="#6FB3E0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollPageButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="VerticalScrollTemplate" TargetType="{x:Type ScrollBar}">
    <Border Background="{TemplateBinding Background}">
      <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource ScrollThumb}" MinHeight="36"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Border>
  </ControlTemplate>

  <ControlTemplate x:Key="HorizontalScrollTemplate" TargetType="{x:Type ScrollBar}">
    <Border Background="{TemplateBinding Background}">
      <Track x:Name="PART_Track">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource ScrollThumb}" MinWidth="36"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Border>
  </ControlTemplate>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="MinWidth" Value="12"/>
    <Setter Property="Template" Value="{StaticResource VerticalScrollTemplate}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="MinHeight" Value="12"/>
        <Setter Property="Template" Value="{StaticResource HorizontalScrollTemplate}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- In a 500-page book a proportional thumb shrinks to a dot, so the reader gets a fixed-size one.
       ViewportSize="NaN" stops the Track from sizing the thumb by the viewport. -->
  <ControlTemplate x:Key="ReaderVerticalScrollTemplate" TargetType="{x:Type ScrollBar}">
    <Border Background="{TemplateBinding Background}">
      <Track x:Name="PART_Track" IsDirectionReversed="True" ViewportSize="NaN">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource ScrollThumb}" Height="48"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Border>
  </ControlTemplate>

  <Style x:Key="ReaderScrollBar" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource {x:Type ScrollBar}}">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Template" Value="{StaticResource ReaderVerticalScrollTemplate}"/>
  </Style>

  <!-- One textbook card in the sidebar: two short lines and a thin progress bar.
       Rename / archive buttons float over the right edge on hover, so titles don't reflow. -->
  <DataTemplate x:Key="BookTemplate">
    <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="10" Padding="10,6,6,7" Margin="0,0,0,5" Cursor="Hand">
      <Grid>
        <StackPanel>
          <TextBlock x:Name="TitleText" Text="{Binding Title}" ToolTip="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                     TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkBrush}"/>
          <TextBlock x:Name="SubText" Text="{Binding PageText}" FontSize="11" Margin="0,1,0,4"
                     TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkSoftBrush}"/>
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Style="{StaticResource CuteProgress}" Height="3"/>
        </StackPanel>
        <Border x:Name="Actions" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Padding="4,0,0,0"
                Background="{Binding Background, ElementName=Card}" CornerRadius="8" Visibility="Hidden">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource FlatButton}" Padding="4" Tag="rename" ToolTip="Переименовать (F2)">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconEdit}"/>
            </Button>
            <Button x:Name="ArchiveButton" Style="{StaticResource FlatButton}" Padding="4" Tag="archive" ToolTip="Отправить в архив">
              <Path x:Name="ArchiveIcon" Style="{StaticResource IconPath}" Data="{StaticResource IconArchive}"/>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
        <Setter TargetName="Card" Property="BorderBrush" Value="#B9DEF5"/>
        <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
      </Trigger>
      <DataTrigger Binding="{Binding IsOpen}" Value="True">
        <Setter TargetName="Card" Property="Background" Value="#E1F2FD"/>
        <Setter TargetName="Card" Property="BorderBrush" Value="#94CDF0"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Archived}" Value="True">
        <Setter TargetName="ArchiveIcon" Property="Data" Value="{StaticResource IconRestore}"/>
        <Setter TargetName="ArchiveButton" Property="ToolTip" Value="Вернуть в текущие"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsRemoteOnly}" Value="True">
        <Setter TargetName="SubText" Property="Foreground" Value="{StaticResource SkyDeepBrush}"/>
        <Setter TargetName="Card" Property="Opacity" Value="0.75"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsMissing}" Value="True">
        <Setter TargetName="SubText" Property="Foreground" Value="{StaticResource PinkBrush}"/>
        <Setter TargetName="TitleText" Property="Opacity" Value="0.55"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- One tab of the open book, styled like the Текущие / Архив switch. The hidden bold copy of the
       name keeps the width steady when the tab turns bold, so the toolbar doesn't jump. -->
  <DataTemplate x:Key="ReadingTabTemplate">
    <Border x:Name="Pill" Background="Transparent" CornerRadius="8" Padding="11,4" Cursor="Hand" ToolTip="{Binding Hint}">
      <Grid>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" MaxWidth="160" TextTrimming="CharacterEllipsis" Visibility="Hidden"/>
        <TextBlock x:Name="NameText" Text="{Binding Name}" MaxWidth="160" TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center" Foreground="{StaticResource InkSoftBrush}"/>
        <TextBox x:Name="NameBox" Style="{StaticResource TabNameBox}" Visibility="Collapsed"/>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <Trigger SourceName="Pill" Property="IsMouseOver" Value="True">
        <Setter TargetName="Pill" Property="Background" Value="#EEF7FD"/>
        <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource InkBrush}"/>
      </Trigger>
      <DataTrigger Binding="{Binding IsActive}" Value="True">
        <Setter TargetName="Pill" Property="Background" Value="White"/>
        <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
        <Setter TargetName="Pill" Property="Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="#4E7CA8"/>
          </Setter.Value>
        </Setter>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
